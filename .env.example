# TrustDonate Environment Configuration Example
# Copy this file to .env or .env.local for local development.
# DO NOT commit actual secrets, private keys, or seed phrases.

# Ethereum Sepolia Network Configuration
VITE_SEPOLIA_CHAIN_ID=11155111
VITE_SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Deployed DonationTracker Contract Address on Sepolia
# (Set this when deploying or connecting to an existing contract on Sepolia)
VITE_DONATION_TRACKER_ADDRESS=
